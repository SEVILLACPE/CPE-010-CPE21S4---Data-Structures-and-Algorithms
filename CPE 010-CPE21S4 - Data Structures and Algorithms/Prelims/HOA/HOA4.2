#include <iostream>
using namespace std;

class Node {
public:
    char data;
    Node* next;
    Node(char c) { data = c; next = nullptr; }
};

class Stack {
    Node* top;
public:
    Stack() { top = nullptr; }

    void push(char c) {
        Node* newNode = new Node(c);
        newNode->next = top;
        top = newNode;
    }

    char pop() {
        if (!top) {
            cout << "Stack Underflow\n";
            return '\0';
        }
        char c = top->data;
        Node* temp = top;
        top = top->next;
        delete temp;
        return c;
    }

    bool isEmpty() { return top == nullptr; }
};

bool isBalanced(const string &expr) {
    Stack s;
    for (char c : expr) {
        if (c == '(' || c == '{' || c == '[')
            s.push(c);
        else if (c == ')' || c == '}' || c == ']') {
            if (s.isEmpty()) return false;
            char top = s.pop();
            if ((c == ')' && top != '(') ||
                (c == '}' && top != '{') ||
                (c == ']' && top != '['))
                return false;
        }
    }
    return s.isEmpty();
}

int main() {
    string expressions[] = {"(A+B)+(C-D)", "((A+B)+(C-D)", "(A+B)+(C-D))", "((A+B)+(C-D))"};
    for (string expr : expressions) {
        cout << expr << " -> " << (isBalanced(expr) ? "Valid" : "Invalid") << endl;
    }
    return 0;
}
